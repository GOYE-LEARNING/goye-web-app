# Backend API URL - REQUIRED
# This should point to your backend server
# For production: Use the Render backend URL
# For local development: Use your local backend URL (if running locally)
NEXT_PUBLIC_API_URL=http://localhost:10000

# ShekiAI assistant feature toggle — set to "true" to show the AI widget in
# the student/tutor dashboards. Currently off while the feature is paused.
NEXT_PUBLIC_ENABLE_AI=false
